# Copia este fichero a «.env» y rellena tu token real.
# .env está en .gitignore: el token NUNCA se sube al repo.
#
#   cp .env.example .env
#   # edita .env con tu Personal Access Token de Airtable
#   # (scopes necesarios: data.records:read/write, schema.bases:read/write)
#
# Cárgalo antes de ejecutar:
#   export $(grep -v '^#' .env | xargs)     # o usa direnv / tu método preferido

AIRTABLE_TOKEN=pat_pon_aqui_tu_token
